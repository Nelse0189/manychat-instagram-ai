PORT=8787
# Leave blank while this app only calls ManyChat, OpenRouter, and Firebase.
# Set it when ManyChat must POST incoming DMs here, or when a customer opens a download link.
# That can be a tunnel to this machine. The app is not deployed to a cloud host.
PUBLIC_BASE_URL=

# Shared secret ManyChat sends as x-webhook-secret. Required when NODE_ENV=production.
WEBHOOK_SECRET=
# Protects GET/POST /admin/*. Required when NODE_ENV=production.
ADMIN_SECRET=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. The dynamic-block response is what ManyChat shows the customer.
MANYCHAT_API_TOKEN=

FIREBASE_PROJECT_ID=arial-luxe-shop
FIREBASE_DATABASE_ID=shop
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n escapes, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Customers pay these handles for a photo or video pack from media/hernandez_sari_.
PAYMENTS_ENABLED=true
VENMO_HANDLE=bluejays0137
CASHAPP_CASHTAG=Arialluxe
SHOP_HANDLE=arial_luxe
